# VoiceBridge Environment Configuration

# Keep-Alive Self-Ping (prevents free-tier container sleep)
KEEP_ALIVE=true

# JWT Authentication
JWT_SECRET=change_me_to_a_secure_random_hex_key_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# WebRTC ICE & TURN Relays (comma-separated, optional overrides)
# STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_SERVER_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject

# Dual-Gateway Monetization: Razorpay (INR)
RAZORPAY_KEY_ID=rzp_test_voicebridge_sandbox
RAZORPAY_KEY_SECRET=secret_voicebridge_sandbox_2026

# Dual-Gateway Monetization: Stripe (USD)
STRIPE_PUBLISHABLE_KEY=pk_test_voicebridge_sandbox
STRIPE_SECRET_KEY=sk_test_voicebridge_sandbox_2026
STRIPE_WEBHOOK_SECRET=
